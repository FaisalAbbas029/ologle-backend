# ============================================================
# OLOGLE BACKEND — Environment Configuration
# ============================================================

# Server Port (default: 3000)
PORT=3000

# Environment Mode
NODE_ENV=production

# Gemini AI API Key (required for Smart Icebreakers, Live Captions translation, Audio Transcription)
GEMINI_API_KEY=""

# Allowed CORS Origins (comma-separated)
# All *.vercel.app domains and localhost are automatically allowed by default
ALLOWED_ORIGINS="https://ologle.network,https://www.ologle.network"

# TURN Server Credentials (critical for WebRTC NAT traversal across cellular/firewalls)
# Example using Metered.ca free tier:
#   TURN_URLS="turn:a.relay.metered.ca:80,turn:a.relay.metered.ca:443,turns:a.relay.metered.ca:443"
#   TURN_SHARED_SECRET="your_shared_secret"
TURN_URLS=""
TURN_SHARED_SECRET=""
TURN_CREDENTIAL_TTL_SECONDS=600

# Optional: External Shared State for Multi-Instance / Cluster scaling (e.g. Upstash / Redis URL)
# REDIS_URL=""

